{
  "editor.tabSize": 2,
  "javascript.format.semicolons": "insert",
  "typescript.format.semicolons": "insert",
  "eslint.autoFixOnSave": true,
  "eslint.validate": [
    {
      "language": "typescript",
      "autoFix": true
    },
    {
      "language": "typescriptreact",
      "autoFix": true
    }
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
}
